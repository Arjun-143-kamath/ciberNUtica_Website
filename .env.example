# Copy this file to .env and replace all example values. Use unique random secrets.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://cibernutica:replace-with-a-random-database-password@localhost:5432/cibernutica?schema=public
FLAG_PEPPER=replace-with-another-random-secret-of-at-least-32-characters
